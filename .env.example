# ==============================================================================
# JOD Business Services (jodbs.com) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your production values.
# On GoDaddy cPanel, you can place .env in the web root or (ideally) one level
# above public_html for enhanced defense-in-depth.
#
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false

# ------------------------------------------------------------------------------
# ZeptoMail SMTP Configuration
# ------------------------------------------------------------------------------
# ZeptoMail SMTP Settings:
# - SMTP_HOST: Typically smtp.zeptomail.in (India) or smtp.zeptomail.com (US)
# - SMTP_PORT: 587 (TLS/STARTTLS) or 465 (SSL)
# - SMTP_USERNAME: emailapikey (default for ZeptoMail)
# - SMTP_PASSWORD: Your ZeptoMail Send Mail Token / Password
# - SMTP_ENCRYPTION: tls (for port 587) or ssl (for port 465)
# - SMTP_FROM_EMAIL: A verified sender email domain in ZeptoMail (e.g. noreply@jodbs.com)
# - SMTP_FROM_NAME: Name displayed as sender (e.g. JOD Business Services)
# - SMTP_TO_EMAIL: Where inquiries should be delivered (e.g. info@jodbs.com)
# - SMTP_TO_NAME: Destination recipient name
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="JOD Business Services"
SMTP_TO_EMAIL=
SMTP_TO_NAME="JOD Business Services"

# ------------------------------------------------------------------------------
# WordPress Blog Database Configuration (/blog)
# ------------------------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
